// schema.prisma 

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum UserPlan {
  FREE
  PRO
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

model User {
  id             Int             @id @default(autoincrement())
  googleId       String?         @unique
  name           String
  email          String          @unique
  password       String?         // Hashed password for non-Google users
  profilePicture String? // URL to the profile picture
  role           UserRole        @default(USER)
  isOnboarded    Boolean         @default(false)
  credits        Float           @default(100.0) // Available credits
  stripeCustomerId String?       @unique
  plan           UserPlan        @default(FREE)
  isOverDue      Boolean         @default(false)
  planExpiringAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? // Soft delete
  files          File[]
  creditHistory  CreditHistory[]
  blogs          Blog[]
}


model Package {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  isFeatured    Boolean  @default(false)
  price         Decimal
  currencySymbol String  @default("$")
  features      Json     // JSON array of features
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}



model File {
  id                 Int                 @id @default(autoincrement())
  userId             Int?
  filename           String
  originalName       String
  mimeType           String
  size               Int // File size in bytes
  url                String? // Storage URL (S3, Supabase, etc.)
  metadata           Json? // Additional file metadata
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // Soft delete
  user               User?               @relation(fields: [userId], references: [id])
}

model CreditHistory {
  id                Int                   @id @default(autoincrement())
  userId            Int
  type              CreditTransactionType
  operation         CreditOperation
  amount            Float // Amount of credits (positive for credit, negative for debit)
  balanceAfter      Float // Balance after this transaction
  objectId          String? // Related object ID (messageId, searchQueryId, etc.)
  description       String? // Optional description
  createdAt         DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum CreditOperation {
  INITIAL_CREDITS
}

model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  content      String
  tags         String[] // Tags stored as array
  blogImageUrl String?  @db.VarChar(255)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorId     Int // References User

  author     User           @relation(fields: [authorId], references: [id])
  categories BlogCategory[]
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @default(now()) @db.Timestamptz()
  blogs     BlogCategory[]
}

model BlogCategory {
  blogId     Int
  categoryId Int

  blog     Blog     @relation(fields: [blogId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([blogId, categoryId])
}

model EmailOTP {
  id         Int        @id @default(autoincrement())
  email      String
  otp        String
  purpose    OtpPurpose
  expiringAt DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([email, purpose])
  @@index([expiringAt])
}
