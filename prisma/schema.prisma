// schema.prisma 

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum UserPlan {
  FREE
  PRO
}

model User {
  id             Int             @id @default(autoincrement())
  clerkUserId    String          @unique
  name           String
  email          String          @unique
  profilePicture String? // URL to the profile picture
  role           UserRole        @default(USER)
  isOnboarded    Boolean         @default(false)
  credits        Float           @default(100.0) // Available credits
  stripeCustomerId String?       @unique
  plan           UserPlan        @default(FREE)
  isOverDue      Boolean         @default(false)
  planExpiringAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? // Soft delete
  threads        Thread[]
  personas       Persona[]
  files          File[]
  knowledgeBases KnowledgeBase[]
  searchQueries  SearchQuery[]
  creditHistory  CreditHistory[]
}

model Thread {
  id             Int       @id @default(autoincrement())
  userId         Int
  openaiThreadId String?
  personaId      Int?
  title          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete
  user           User      @relation(fields: [userId], references: [id])
  persona        Persona?  @relation(fields: [personaId], references: [id])
  messages       Message[]
}

model Persona {
  id                Int            @id @default(autoincrement())
  userId            Int?
  openaiAssistantId String?
  knowledgeBaseId   Int?
  name              String
  description       String
  instructions      String
  tags              String[]
  logo              String? // URL to the logo image in S3
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User?          @relation(fields: [userId], references: [id])
  knowledgeBase     KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id])
  threads           Thread[]
}

model KnowledgeBase {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  title              String
  description        String
  metadata           Json?
  vectorStoreId      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // Soft delete
  user               User                @relation(fields: [userId], references: [id])
  personas           Persona[]
  fileKnowledgeBases FileKnowledgeBase[]
  searchQueries      SearchQuery[]
}

model Message {
  id              Int           @id @default(autoincrement())
  threadId        Int
  openaiMessageId String?
  role            String
  content         String
  citations       Json? // Store citation data as JSON
  timestamp       DateTime      @default(now())
  deletedAt       DateTime? // Soft delete
  thread          Thread        @relation(fields: [threadId], references: [id])
  messageFiles    MessageFile[]
}

model File {
  id                 Int                 @id @default(autoincrement())
  userId             Int?
  openaiFileId       String?             @unique
  filename           String
  originalName       String
  mimeType           String
  size               Int // File size in bytes
  url                String? // Storage URL (S3, Supabase, etc.)
  metadata           Json? // Additional file metadata
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // Soft delete
  user               User?               @relation(fields: [userId], references: [id])
  fileKnowledgeBases FileKnowledgeBase[]
  messageFiles       MessageFile[]
  searchResults      SearchResult[]
}

model FileKnowledgeBase {
  id              Int           @id @default(autoincrement())
  fileId          Int
  knowledgeBaseId Int
  createdAt       DateTime      @default(now())
  file            File          @relation(fields: [fileId], references: [id])
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])

  @@unique([fileId, knowledgeBaseId])
}

model MessageFile {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileId    Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
}

model CreditHistory {
  id                Int                   @id @default(autoincrement())
  userId            Int
  type              CreditTransactionType
  operation         CreditOperation
  amount            Float // Amount of credits (positive for credit, negative for debit)
  balanceAfter      Float // Balance after this transaction
  objectId          String? // Related object ID (messageId, searchQueryId, etc.)
  description       String? // Optional description
  createdAt         DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum SearchMode {
  SMART_SEARCH
  QA
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum CreditOperation {
  CHAT
  SMART_SEARCH
  SMART_QA
  INITIAL_CREDITS
  MANUAL_ADJUSTMENT
  CREDIT_PURCHASE
}

model SearchQuery {
  id              Int            @id @default(autoincrement())
  publicId        String         @unique @default(uuid())
  userId          Int
  knowledgeBaseId Int?
  query           String
  mode            SearchMode
  resultsCount    Int            @default(0)
  answer          String?
  createdAt       DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id])
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id])
  results         SearchResult[]

  @@index([userId])
  @@index([knowledgeBaseId])
  @@index([mode, createdAt])
}

model SearchResult {
  id            String      @id @default(uuid())
  searchQueryId Int
  rank          Int
  openaiFileId  String?
  fileId        Int?
  filename      String
  score         Float
  attributes    Json?
  content       Json?
  createdAt     DateTime    @default(now())

  searchQuery   SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  file          File?       @relation(fields: [fileId], references: [id])

  @@unique([searchQueryId, rank])
  @@index([openaiFileId])
  @@index([fileId])
}
