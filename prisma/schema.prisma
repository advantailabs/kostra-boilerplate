// schema.prisma 

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum UserPlan {
  FREE
  PRO
}

model User {
  id             Int             @id @default(autoincrement())
  googleId       String?         @unique
  name           String
  email          String          @unique
  profilePicture String? // URL to the profile picture
  role           UserRole        @default(USER)
  isOnboarded    Boolean         @default(false)
  credits        Float           @default(100.0) // Available credits
  stripeCustomerId String?       @unique
  plan           UserPlan        @default(FREE)
  isOverDue      Boolean         @default(false)
  planExpiringAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? // Soft delete
  personas       Persona[]
  files          File[]
  creditHistory  CreditHistory[]
}


model Persona {
  id                Int            @id @default(autoincrement())
  userId            Int?
  name              String
  description       String
  instructions      String
  tags              String[]
  logo              String? // URL to the logo image in S3
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User?          @relation(fields: [userId], references: [id])
}



model File {
  id                 Int                 @id @default(autoincrement())
  userId             Int?
  openaiFileId       String?             @unique
  filename           String
  originalName       String
  mimeType           String
  size               Int // File size in bytes
  url                String? // Storage URL (S3, Supabase, etc.)
  metadata           Json? // Additional file metadata
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // Soft delete
  user               User?               @relation(fields: [userId], references: [id])
}

model CreditHistory {
  id                Int                   @id @default(autoincrement())
  userId            Int
  type              CreditTransactionType
  operation         CreditOperation
  amount            Float // Amount of credits (positive for credit, negative for debit)
  balanceAfter      Float // Balance after this transaction
  objectId          String? // Related object ID (messageId, searchQueryId, etc.)
  description       String? // Optional description
  createdAt         DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum CreditOperation {
  INITIAL_CREDITS
}
