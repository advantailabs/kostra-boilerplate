{
  "name": "kostra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "instrumentation": {
    "client": "./src/instrumentation-client.ts",
    "server": "./src/instrumentation.ts"
  },
  "scripts": {
    "dev": "next dev",
    "check-types": "tsc --noEmit",
    "build": "next build && npm run verify-sitemap",
    "build:only": "next build",
    "start": "next start",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "prisma db seed",
    "lint": "eslint .",
    "generate": "prisma generate",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "jest --verbose --no-coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:local": "POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5433/kostra_test?schema=public TEST_APP_URL=http://localhost:3001 NODE_ENV=test npm run test",
    "verify-sitemap": "echo '✅ Checking sitemap generation...' && ls -la .next/server/app/sitemap.xml* && echo '✅ Sitemap generated successfully!' || echo '❌ Sitemap generation failed!'",
    "deploy": "bash deploy.sh",
    "release": "tsx release.js",
    "preview-sitemap": "cat .next/server/app/sitemap.xml.body 2>/dev/null || echo 'No sitemap found. Run npm run build first.'",
    "preview-robots": "cat .next/server/app/robots.txt.body 2>/dev/null || echo 'No robots.txt found. Run npm run build first.'"
  },
